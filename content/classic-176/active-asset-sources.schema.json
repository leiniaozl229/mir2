{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Active resource sources and optional reference candidates",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "targetVersion",
    "roots",
    "scope",
    "assets"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "targetVersion": {
      "type": "string",
      "minLength": 1
    },
    "scope": {
      "type": "string",
      "minLength": 1
    },
    "roots": {
      "type": "object",
      "required": [
        "repository"
      ],
      "properties": {
        "repository": {
          "const": "."
        }
      },
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    },
    "assets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/asset"
      }
    }
  },
  "$defs": {
    "sourceFile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "root",
        "path",
        "purpose",
        "bytes",
        "sha256"
      ],
      "properties": {
        "root": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\\\:]+$"
        },
        "purpose": {
          "enum": [
            "identity",
            "data",
            "index"
          ]
        },
        "bytes": {
          "type": "integer",
          "minimum": 0
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "library": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "manifests",
        "format",
        "sourceFrameCount",
        "coverage"
      ],
      "properties": {
        "manifests": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\\\:]+$"
          }
        },
        "format": {
          "const": "wil-classic"
        },
        "sourceFrameCount": {
          "type": "integer",
          "minimum": 1
        },
        "coverage": {
          "enum": [
            "all_source",
            "map_dependencies"
          ]
        },
        "profile": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "asset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "role",
        "provenance",
        "version",
        "namespace",
        "category",
        "kind",
        "sourceFiles"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "role": {
          "enum": [
            "active_required",
            "reference_candidate"
          ]
        },
        "provenance": {
          "enum": [
            "native_pixels",
            "reference_source"
          ]
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "namespace": {
          "type": "string",
          "minLength": 1
        },
        "category": {
          "enum": [
            "map",
            "actor",
            "effect",
            "item",
            "audio",
            "ui",
            "cursor"
          ]
        },
        "kind": {
          "enum": [
            "library",
            "file"
          ]
        },
        "sourceFiles": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/sourceFile"
          }
        },
        "library": {
          "$ref": "#/$defs/library"
        },
        "exports": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\\\:]+$"
          }
        },
        "exportManifest": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "file"
          ],
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1,
              "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\\\:]+$"
            },
            "file": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "contractBinding": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "key"
          ],
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1,
              "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\\\:]+$"
            },
            "key": {
              "type": "string",
              "minLength": 1
            },
            "file": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "origin": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "scope"
          ],
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1,
              "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\\\:]+$"
            },
            "scope": {
              "type": "string",
              "minLength": 1
            },
            "url": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "library"
              }
            }
          },
          "then": {
            "required": [
              "library"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "file"
              }
            }
          },
          "then": {
            "required": [
              "exports"
            ]
          }
        }
      ]
    }
  }
}
