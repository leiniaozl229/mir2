+        private void GetQuestRecord(int playerId, StorageContext context, ref CharacterDataInfo humanRcd)
+        {
+            const string sql = "SELECT QUESTOPENINDEX, QUESTFININDEX, QUEST FROM characters_quest WHERE PLAYERID=@PlayerId ORDER BY Id DESC LIMIT 1";
