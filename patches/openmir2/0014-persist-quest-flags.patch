+                LogService.Error("[Exception] PlayDataStorage.GetQuestRecord: " + ex.Message);
+            }
+        }
+
+        private static byte[] DecodeQuestBytes(MySqlConnector.MySqlDataReader reader, string name)
+        {
+            if (reader.IsDBNull(reader.GetOrdinal(name))) return new byte[128];
+            string value = reader.GetString(name);
+            if (string.IsNullOrWhiteSpace(value)) return new byte[128];
+            try
+            {
+                byte[] decoded = Convert.FromBase64String(value);
+                if (decoded.Length == 128) return decoded;
+            }
+            catch (FormatException) { }
+            byte[] fallback = new byte[128];
+            string[] fields = value.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
+            for (int i = 0; i < Math.Min(fields.Length, fallback.Length); i++)
+                if (byte.TryParse(fields[i], out byte item)) fallback[i] = item;
+            return fallback;
+        }
 
