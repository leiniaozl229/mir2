+                MySqlConnector.MySqlCommand command = context.CreateCommand();
+                command.CommandText = sql;
+                command.Parameters.AddWithValue("@PlayerId", playerId);
+                using MySqlConnector.MySqlDataReader reader = command.ExecuteReader();
