+                humanRcd.Data.QuestUnitOpen = DecodeQuestBytes(reader, "QUESTOPENINDEX");
+                humanRcd.Data.QuestFlag = DecodeQuestBytes(reader, "QUESTFININDEX");
+                humanRcd.Data.QuestUnit = DecodeQuestBytes(reader, "QUEST");
+            }
