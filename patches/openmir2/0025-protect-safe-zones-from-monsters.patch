@@ -820,0 +826,35 @@ namespace GameSrv.Word
+        private static bool MoveSpawnOutsideSafeZone(SystemModule.Maps.IEnvirnoment map, ref short nX, ref short nY)
+        {
+            if (!M2Server.Actor.BaseObject.IsSafeZonePosition(map, nX, nY))
+            {
+                return true;
+            }
+            int searchRadius = SystemShare.Config.SafeZoneSize + 16;
+            for (int distance = 1; distance <= searchRadius; distance++)
+            {
+                for (int offset = -distance; offset <= distance; offset++)
+                {
+                    if (TryUseSpawnPosition(map, nX + offset, nY - distance, out short candidateX, out short candidateY) ||
+                        TryUseSpawnPosition(map, nX + distance, nY + offset, out candidateX, out candidateY) ||
+                        TryUseSpawnPosition(map, nX + offset, nY + distance, out candidateX, out candidateY) ||
+                        TryUseSpawnPosition(map, nX - distance, nY + offset, out candidateX, out candidateY))
+                    {
+                        nX = candidateX;
+                        nY = candidateY;
+                        return true;
+                    }
+                }
+            }
+            return false;
+        }
+
+        private static bool TryUseSpawnPosition(SystemModule.Maps.IEnvirnoment map, int nX, int nY,
+            out short candidateX, out short candidateY)
+        {
+            candidateX = (short)nX;
+            candidateY = (short)nY;
+            return nX >= 0 && nX < map.Width && nY >= 0 && nY < map.Height &&
+                   map.CanWalk(candidateX, candidateY, false) &&
+                   !M2Server.Actor.BaseObject.IsSafeZonePosition(map, candidateX, candidateY);
+        }
+
